@model IEnumerable<JayStudyGroupProfilesV3.Models.PersonModel>

@{
    ViewBag.Title = "List of Members";
}

<h2>List of People</h2>

<div class="mb-3">
    <input type="text" id="searchInput" class="form-control" placeholder="Search String..." />
    <button id="searchButton" class="btn btn-outline-success mt-2">Search</button>
</div>

<p>
    @Html.ActionLink("Create New", "AddPerson")
</p>

<table class="table" id="peopleTable">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.stuNum)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.fName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.lName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.email)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.delete)
        </th>
        <th></th>
    </tr>

    @foreach (var person in Model) //For each person
    {
        <tr data-firstname="@person.fName">
            <td>
                @Html.DisplayFor(modelItem => person.stuNum)
            </td>
            <td>
                @Html.DisplayFor(modelItem => person.fName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => person.lName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => person.email)
            </td>
            <td>
                <a href="@person.delete" class="btn btn-outline-danger" onclick="deleteRow(this)">DELETE</a>
            </td>

        </tr>
    }

</table>

<button id="saveButton" class="btn btn-outline-success">Save to Local Storage</button>
<button id="retrieveButton" class="btn btn-outline-secondary">Retrieve from Local Storage</button>
<button id="clearButton" class="btn btn-outline-danger">Clear Local Storage</button>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            //SEARCH
            const searchInput = document.getElementById("searchInput");
            const searchBtn = document.getElementById("searchButton");
            const table = document.getElementById("peopleTable"); // Ensure this is correctly targeting your table!
            const rows = table.querySelectorAll("tr[data-firstname]");

            searchBtn.addEventListener("click", function () {
                const searchTerm = searchInput.value.toLowerCase();

                rows.forEach(row => {
                    const firstName = row.getAttribute("data-firstname").toLowerCase();
                    const cells = row.cells;

                    if (firstName.includes(searchTerm)) {
                        Array.from(cells).forEach(cell => {
                            cell.style.color = "red";
                        });

                        setTimeout(() => {
                            Array.from(cells).forEach(cell => {
                                cell.style.color = "";
                            });
                        }, 3000);
                    } else {
                        Array.from(cells).forEach(cell => {
                            cell.style.color = "";
                        });
                    }
                });
            });

            //LOCAL STOR
            const saveButton = document.getElementById("saveButton");
            const retrieveButton = document.getElementById("retrieveButton");
            const clearButton = document.getElementById("clearButton");
           
            saveButton.addEventListener("click", function () {
                const dataString = getTableDataAsString();
                console.log("Saving:", dataString);
                localStorage.setItem("peopleData", dataString);
                alert("Saved.");
            });

            retrieveButton.addEventListener("click", function () {
                const storedData = localStorage.getItem("peopleData");
                console.log("Retrieved:", storedData);
                if (storedData) {
                    clearTable();
                    populateTableFromString(storedData);
                    alert("Retrieved.");
                } else {
                    alert("No data.");
                }
            });

            clearButton.addEventListener("click", function () {
                localStorage.removeItem("peopleData");
                clearTable();
                alert("Cleared.");
            });

            function getTableDataAsString() {
                let dataString = "";
                const rows = table.querySelectorAll("tr[data-firstname]");
                rows.forEach(row => {
                    dataString += row.cells[0].textContent + ",";
                    dataString += row.cells[1].textContent + ",";
                    dataString += row.cells[2].textContent + ",";
                    dataString += row.cells[3].textContent + ";";
                });
                return dataString;
            }

            function clearTable() {
                const rows = table.querySelectorAll("tr[data-firstname]");
                rows.forEach(row => row.remove());
            }

            function populateTableFromString(dataString) {
                const rowsData = dataString.split(";");
                rowsData.forEach(rowData => {
                    if (rowData) {
                        const values = rowData.split(",");
                        console.log("Values:", values);
                        if (values.length === 4) {
                            const newRow = table.insertRow();
                            newRow.setAttribute("data-firstname", values[1]);
                            const cell1 = newRow.insertCell(0);
                            const cell2 = newRow.insertCell(1);
                            const cell3 = newRow.insertCell(2);
                            const cell4 = newRow.insertCell(3);
                            const cell5 = newRow.insertCell(4);
                            cell1.textContent = values[0];
                            cell2.textContent = values[1];
                            cell3.textContent = values[2];
                            cell4.textContent = values[3];

                            let deleteLink = document.createElement('a');
                            deleteLink.href = "#";
                            deleteLink.className = "btn btn-outline-danger";
                            deleteLink.textContent = "DELETE";
                            deleteLink.onclick = function () {
                                deleteRow(newRow);
                            };
                            cell5.appendChild(deleteLink);
                        }
                    }
                });
            }

            function deleteRow(row) {
                row.remove();
            }
        });
    </script>
    @Scripts.Render("~/bundles/jqueryval")
}

<script src="~/Scripts/myScript.js"></script>
